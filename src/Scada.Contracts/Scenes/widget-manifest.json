{
  "schemaVersion": 1,
  "widgetTypes": ["connector", "image", "motor", "pipe", "text"],
  "bindingTargets": ["attr:fill", "attr:opacity", "attr:stroke", "text:value", "visibility"],
  "actionKinds": ["command"],
  "routingKinds": ["orthogonal", "straight"],
  "limits": {
    "elements": 300,
    "nesting": 8,
    "vertices": 4,
    "segments": 4,
    "stringLength": 48,
    "numberLexemeLength": 64,
    "numberExponentMagnitude": 64,
    "canonicalNumberLength": 64,
    "requiresExactJavaScriptInteger": true
  },
  "security": {
    "allowsHtml": false,
    "allowsSvg": false,
    "allowsUrls": false,
    "allowsCode": false
  },
  "values": {
    "safeStringPattern": "^[A-Za-z0-9 _.#%+,-]+$",
    "safeStringRationale": "ASCII display tokens only: excludes markup delimiters, URL separators, quotes, escapes, and executable syntax."
  },
  "scene": { "required": ["schemaVersion", "revision", "screenId", "canvas", "layers", "symbols", "elements"], "allowed": ["schemaVersion", "revision", "screenId", "canvas", "layers", "symbols", "elements"], "minimum": { "revision": 0 } },
  "canvas": { "required": ["width", "height", "viewBox"], "allowed": ["width", "height", "viewBox"], "positive": ["width", "height"], "viewBox": { "required": ["x", "y", "width", "height"], "allowed": ["x", "y", "width", "height"], "positive": ["width", "height"] } },
  "symbol": { "required": ["rootElementId"], "allowed": ["rootElementId"] },
  "geometry": {
    "box": { "kind": "box", "required": ["kind", "x", "y", "w", "h", "rotation"], "allowed": ["kind", "x", "y", "w", "h", "rotation"], "positive": ["w", "h"] },
    "point": { "required": ["x", "y"], "allowed": ["x", "y"] },
    "points": { "kind": "points", "required": ["kind", "vertices"], "allowed": ["kind", "vertices"], "array": { "minItems": 2, "maxItems": 4 } },
    "path": { "kind": "path", "required": ["kind", "segments"], "allowed": ["kind", "segments"], "array": { "maxItems": 4, "item": { "required": ["kind", "x", "y"], "allowed": ["kind", "x", "y"], "kinds": ["move", "line"] } } },
    "link": { "kind": "link", "required": ["kind", "fromRef", "toRef", "routing"], "allowed": ["kind", "fromRef", "toRef", "routing"] }
  },
  "elementOwnership": {
    "group": ["id", "kind", "parentId", "layer", "geometry"],
    "widget": ["id", "kind", "parentId", "layer", "widgetType", "geometry", "bindings", "actions", "props"],
    "instance": ["id", "kind", "parentId", "layer", "symbolId", "tagScope", "geometry"]
  },
  "bindings": {
    "direct": { "required": ["tier", "tag", "target"], "allowed": ["tier", "tag", "target"] },
    "map": { "required": ["tier", "tag", "target", "map"], "allowed": ["tier", "tag", "target", "map"] }
  },
  "actions": {
    "command": { "required": ["kind", "commandId", "parameters"], "allowed": ["kind", "commandId", "parameters"] }
  }
}
