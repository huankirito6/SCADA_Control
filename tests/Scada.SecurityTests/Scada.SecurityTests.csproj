<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <ProcessTreeFixtureProject>$(MSBuildThisFileDirectory)Fixtures\ProcessTreeFixture\ProcessTreeFixture.csproj</ProcessTreeFixtureProject>
    <ProcessTreeFixtureOutput>$(MSBuildThisFileDirectory)Fixtures\ProcessTreeFixture\bin\$(Configuration)\net10.0\</ProcessTreeFixtureOutput>
  </PropertyGroup>

  <Target Name="BuildAndCopyProcessTreeFixture" BeforeTargets="Build">
    <MSBuild Projects="$(ProcessTreeFixtureProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RestoreLockedMode=true" />
    <ItemGroup>
      <ProcessTreeFixtureFiles Include="$(ProcessTreeFixtureOutput)ProcessTreeFixture.dll" />
      <ProcessTreeFixtureFiles Include="$(ProcessTreeFixtureOutput)ProcessTreeFixture.deps.json" />
      <ProcessTreeFixtureFiles Include="$(ProcessTreeFixtureOutput)ProcessTreeFixture.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ProcessTreeFixtureFiles)"
          DestinationFolder="$(OutDir)Fixtures\ProcessTreeFixture\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
